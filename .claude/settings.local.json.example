{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mvn test:*)",
      "Bash(mvn -Dtest=*:*)",
      "Bash(mvn compile:*)",
      "Bash(mvn dependency:tree:*)",
      "Bash(mvn -B test:*)",
      "Bash(mvn spring-boot:run:*)",
      "Bash(./grading/run-grading.sh:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ]
  }
}
